---
import { Picture } from 'astro:assets';
import rajaAmpat from '../assets/raja-ampat.png';
import fanjingshan from '../assets/fanjingshan.png';
import vevey from '../assets/vevey.png';
import skadar from '../assets/skadar.png';

const destinations = [
  {
    name: 'Raja Ampat',
    country: 'Indonesia',
    image: rajaAmpat,
    alt: 'Jungle-covered limestone islets in a turquoise lagoon at Raja Ampat',
  },
  {
    name: 'Fanjingshan',
    country: 'China',
    image: fanjingshan,
    alt: 'The Red Clouds Golden Summit rock pillar rising above green forest on Fanjingshan',
  },
  {
    name: 'Vevey',
    country: 'Switzerland',
    image: vevey,
    alt: 'Red-roofed village and vineyard terraces above Lake Geneva near Vevey',
  },
  {
    name: 'Skadar',
    country: 'Montenegro',
    image: skadar,
    alt: 'River winding through green wetlands and hills around Lake Skadar',
    wide: true,
  },
];
---

<section class="destinations" id="destinations" aria-labelledby="destinations-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="destinations-title">Featured destinations</h2>
      <a class="text-link" href="#finder-title">
        Find a trip
      </a>
    </div>

    <ul class="destinations__grid">
      {destinations.map((d) => (
        <li class:list={['destination', { 'destination--wide': d.wide }]}>
          <Picture
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            src={d.image}
            alt={d.alt}
            widths={d.wide ? [400, 520] : [261, 400]}
            sizes={d.wide ? '(max-width: 880px) 50vw, 40vw' : '(max-width: 880px) 50vw, 20vw'}
          />
          <div class="destination__caption">
            <h3>{d.name}</h3>
            <p>{d.country}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .destinations {
    padding-block: 0 var(--section);
  }

  .destinations__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 2fr);
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    padding: 0;
    list-style: none;
  }

  .destination {
    position: relative;
    overflow: hidden;
    aspect-ratio: 261 / 332;
    border-radius: var(--radius-m);
    background: var(--mint);
    isolation: isolate;
  }

  .destination--wide {
    aspect-ratio: auto;
  }

  /* Out of flow so the wide card takes the row height set by the portrait cards. */
  .destination--wide img {
    position: absolute;
    inset: 0;
  }

  .destination img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .destination::after {
    content: '';
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(180deg, transparent, rgb(6 30 22 / 78%));
  }

  .destination__caption {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: clamp(1rem, 2vw, 1.5rem);
    color: #fff;
  }

  .destination__caption h3 {
    font-size: var(--step-1);
    font-weight: 700;
  }

  .destination__caption p {
    font-size: var(--step--1);
    opacity: 0.9;
  }

  @media (hover: hover) {
    .destination:hover img {
      transform: scale(1.05);
    }
  }

  @media (max-width: 880px) {
    .destinations__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .destination--wide {
      aspect-ratio: 261 / 332;
    }
  }
</style>
