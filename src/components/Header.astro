---
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL;
const links = [
  { href: '#top', label: 'Home', current: true },
  { href: '#destinations', label: 'Destinations' },
  { href: '#about', label: 'About' },
  { href: '#guides', label: 'Partner' },
];
---

<header class="header" id="top">
  <div class="wrap header__bar">
    <a class="header__brand" href={base}>
      <Logo />
      <span class="header__name">Thousand Sunny</span>
    </a>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="header__burger" aria-hidden="true"></span>
    </button>

    <div class="header__menu" id="site-menu" data-menu>
      <nav aria-label="Main">
        <ul class="header__nav">
          {links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="header__actions">
        <button class="btn btn--ghost header__login" type="button" popovertarget="account-note">
          Login
        </button>
        <button class="btn btn--primary" type="button" popovertarget="account-note">
          Register
        </button>
      </div>
    </div>
  </div>

  <div class="note" id="account-note" popover>
    <p class="note__title">Accounts open with the app</p>
    <p>
      Saved trips and bookings arrive with the Thousand Sunny guides app. Until then, the holiday
      finder works without signing in.
    </p>
    <button
      class="btn btn--ghost note__close"
      type="button"
      popovertarget="account-note"
      popovertargetaction="hide"
    >
      Got it
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .header__bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(1.25rem, 3vw, 2.5rem);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .header__brand :global(.logo-mark) {
    transition: transform 0.6s var(--ease);
  }

  .header__brand:hover :global(.logo-mark) {
    transform: rotate(180deg);
  }

  .header__name {
    font-size: 1.0625rem;
  }

  .header__menu {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header__nav {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .header__nav a {
    display: block;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.975rem;
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .header__nav a:hover {
    color: var(--ink);
    background: var(--paper-2);
  }

  .header__nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }

  .header__actions {
    display: flex;
    gap: 0.75rem;
  }

  .header__actions .btn {
    min-height: 42px;
    padding: 0.5rem 1.4rem;
    font-size: 0.95rem;
  }

  .header__login {
    color: #a84a06;
  }

  .header__toggle {
    display: none;
  }

  .note__title {
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .note__close {
    margin-top: 1.25rem;
    min-height: 40px;
    padding: 0.4rem 1.2rem;
  }

  @media (max-width: 880px) {
    .header__bar {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0;
    }

    .header__toggle {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: var(--paper);
      cursor: pointer;
    }

    .header__burger,
    .header__burger::before,
    .header__burger::after {
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: var(--ink);
      transition:
        transform 0.3s var(--ease),
        background-color 0.2s;
    }

    .header__burger {
      position: relative;
    }

    .header__burger::before,
    .header__burger::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .header__burger::before {
      top: -6px;
    }

    .header__burger::after {
      top: 6px;
    }

    [aria-expanded='true'] .header__burger {
      background: transparent;
    }

    [aria-expanded='true'] .header__burger::before {
      transform: translateY(6px) rotate(45deg);
    }

    [aria-expanded='true'] .header__burger::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    .header__menu {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      margin-top: 1rem;
      padding: 1.25rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-m);
      background: var(--paper);
      box-shadow: var(--shadow);
    }

    .header__menu.is-open {
      display: flex;
      animation: menu-in 0.3s var(--ease);
    }

    .header__nav {
      flex-direction: column;
    }

    .header__nav a {
      padding: 0.75rem 1rem;
      border-radius: var(--radius-s);
      font-size: 1.0625rem;
    }

    .header__actions .btn {
      flex: 1;
      min-height: 48px;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>
